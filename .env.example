# Copy to .env (which is gitignored) and fill in.
# Required: your Anthropic API key — https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# OSRS_LLM_MODEL=claude-opus-4-8
# PORT=3000
# RATE_LIMIT_PER_10_MIN=15
# MAX_INPUT_CHARS=24000
# LOG_USAGE=0            # set to 1 to log token usage + cache hits per request
